.container
	.main
		.grid
			.grid-item.welcome.with-col-divisor
				h3.title About me
				p With 12+ years of experience, I am a Front-End Developer & UI/UX Designer based in Rio de Janeiro 🇧🇷, specializing in modern web apps using React, Next.js, and Headless CMS. Strong expertise in branding and visual design, as well as experience working with enterprise portal solutions using HCL Digital Experience.
				a.btn.btn-primary.bold.mt-5(href="#contact")
					i.mr-4.far.fa-comments
					| Start your project

			.grid-item.facts
				h3.title Fun facts
				ul
					li.flex.gap-1
						span.list-icon
							i.fas.fa-biking
						span I enjoy cycling and #[abbr(title="Mountain Biking") MTB]
					li.flex.gap-1
						span.list-icon
							i.fa.fa-pencil
						span I write with my right hand...
					li.flex.gap-1
						span.list-icon
							i.fas.fa-futbol
						span ...but kick with my left foot
					li.flex.gap-1
						span.list-icon
							i.fa.fa-youtube
						span I have a #[a.bold.underlined(href='https://www.youtube.com/@romulobastos' target='_blank') YouTube channel]
					li.flex.gap-1
						span.list-icon
							i.fa.fa-camera
						span I used to work as an event photographer
					li.flex.gap-1
						span.list-icon
							i.fa.fa-graduation-cap
						span Some #[a.bold.underlined(href='https://cursos.alura.com.br/user/romulobastos', rel='noreferrer' target='_blank') courses I've completed]
			
			.grid-item.jobs.with-col-divisor.with-row-divisor
				include includes/my-jobs

			.grid-item.art.with-row-divisor
				.image(style='background-image:url(/img/profile-picture.webp)')