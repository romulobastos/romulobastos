.container
	.main
		.grid
			.grid-item.welcome.with-col-divisor
				h3.title About me
				p Portal Analyst and Web Developer since 2010.
				p I create and keep websites, apps and portals. I bring solutions that improve the digital experience and bring real benefits.
				p Do you want to increase your brand's performance on the internet and expand your communication levels?
				a.btn.btn-primary.bold.mt-5(href="#contact")
					i.mr-4.far.fa-comments
					| Let's start a conversation

			.grid-item.facts
				h3.title Fun facts
				ul
					li.flex.gap-1
						span.list-icon
							i.fas.fa-biking
						span I like cycling and practicing #[abbr(title="Mountain Bike") MTB]
					li.flex.gap-1
						span.list-icon
							i.fa.fa-pencil
						span I write with the right hand...
					li.flex.gap-1
						span.list-icon
							i.fas.fa-futbol
						span ...but I kick with the left foot
					li.flex.gap-1
						span.list-icon
							i.fa.fa-twitch
						span I play and watch #[abbr(title="Counter Strike") CS] in my free time
					li.flex.gap-1
						span.list-icon
							i.fa.fa-images
						span I was an event photographer
					li.flex.gap-1
						span.list-icon
							i.far.fa-star
						span See some #[a.bold.underlined(href='https://cursos.alura.com.br/user/romulobastos', rel='noreferrer' target='_blank') concluded courses]
			
			.grid-item.jobs.with-col-divisor.with-row-divisor
				include includes/my-jobs

			.grid-item.art.with-row-divisor
				.image(style='background-image:url(/img/profile-picture.webp)')