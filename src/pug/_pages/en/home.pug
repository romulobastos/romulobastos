.container
	.main
		.grid
			//- projects
			.grid-item.jobs.with-col-divisor
				include includes/my-jobs

			//- picture
			.grid-item.art
				.image(style='background-image:url(/img/profile-picture.webp)')

			//- aboute me
			.grid-item.welcome.with-col-divisor.with-row-divisor
				h3.title About me
				p Front-end developer and designer with over 15 years of experience. I combine technical expertise in React, Next.js, and Headless CMS with a creative vision focused on UI, branding, and visual design. Always aiming for the perfect balance between form and function.
				a.btn.btn-primary.bold.mt-5(href="#contact")
					i.mr-4.far.fa-comments
					span Start your project

			//- fun facts
			.grid-item.facts.with-row-divisor
				h3.title Fun facts
				ul
					li.flex.gap-1
						span.list-icon
							i.fas.fa-biking
						span I enjoy cycling and #[abbr(title="Mountain Biking") MTB]
					li.flex.gap-1
						span.list-icon
							i.fa.fa-pencil
						span I write with my right hand...
					li.flex.gap-1
						span.list-icon
							i.fas.fa-futbol
						span ...but kick with my left foot
					li.flex.gap-1
						span.list-icon
							i.fa.fa-youtube
						span I have a #[a.bold.underlined(href='https://www.youtube.com/@romulobastos' target='_blank') YouTube channel]
					li.flex.gap-1
						span.list-icon
							i.fa.fa-camera
						span Shot events before
					li.flex.gap-1
						span.list-icon
							i.fa.fa-graduation-cap
						span Completed #[a.bold.underlined(href='https://cursos.alura.com.br/user/romulobastos', rel='noreferrer' target='_blank') some courses]