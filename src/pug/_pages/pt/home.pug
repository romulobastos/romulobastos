.container
	.main
		.grid
			.grid-item.welcome.with-col-divisor
				h3.title Sobre mim
				p Com mais de 12 anos de experiência, sou Front-End Developer & UI/UX Designer no Rio de Janeiro 🇧🇷, especializado em aplicações web modernas com React, Next.js e Headless CMS. Possuo forte experiência em branding e design visual, além de atuar com soluções empresariais de portal utilizando HCL Digital Experience.
				a.btn.btn-primary.bold.mt-5(href="#contato")
					i.mr-4.far.fa-comments
					| Inicie seu projeto
			
			.grid-item.facts
				h3.title Curiosidades
				ul
					li.flex.gap-1
						span.list-icon
							i.fas.fa-biking
						span Gosto de pedalar e praticar #[abbr(title="Mountain Biking") MTB]
					li.flex.gap-1
						span.list-icon
							i.fa.fa-pencil
						span Escrevo com a direita...
					li.flex.gap-1
						span.list-icon
							i.fas.fa-futbol
						span ...mas chuto com a esquerda
					li.flex.gap-1
						span.list-icon
							i.fa.fa-youtube
						span Tenho um #[a.bold.underlined(href='https://www.youtube.com/@romulobastos' target='_blank') canal no YouTube]
					li.flex.gap-1
						span.list-icon
							i.fa.fa-camera
						span Já fui fotógrafo de eventos
					li.flex.gap-1
						span.list-icon
							i.fa.fa-graduation-cap
						span Alguns dos #[a.bold.underlined(href='https://cursos.alura.com.br/user/romulobastos', rel='noreferrer' target='_blank') cursos que fiz]
			
			.grid-item.jobs.with-col-divisor.with-row-divisor
				include includes/my-jobs

			.grid-item.art.with-row-divisor
				.image(style='background-image:url(/img/profile-picture.webp)')