.container
	.main
		.grid
			.grid-item.welcome.with-col-divisor
				h3.title Sobre mim
				p Desenvolvedor front-end e designer com mais de 12 anos de experiência. Combino conhecimento técnico em React, Next.js e Headless CMS com uma visão criativa voltada para UI, branding e design visual. Busco o equilíbrio entre forma e função para criar ótimas experiências.
				a.btn.btn-primary.bold.mt-5(href="#contato")
					i.mr-4.far.fa-comments
					span Inicie seu projeto
			
			.grid-item.facts
				h3.title Curiosidades
				ul
					li.flex.gap-1
						span.list-icon
							i.fas.fa-biking
						span Gosto de pedalar e praticar #[abbr(title="Mountain Biking") MTB]
					li.flex.gap-1
						span.list-icon
							i.fa.fa-pencil
						span Escrevo com a mão direita...
					li.flex.gap-1
						span.list-icon
							i.fas.fa-futbol
						span ...mas chuto com o pé esquerdo
					li.flex.gap-1
						span.list-icon
							i.fa.fa-youtube
						span Tenho um #[a.bold.underlined(href='https://www.youtube.com/@romulobastos' target='_blank') canal no YouTube]
					li.flex.gap-1
						span.list-icon
							i.fa.fa-camera
						span Já fotografei em eventos
					li.flex.gap-1
						span.list-icon
							i.fa.fa-graduation-cap
						span Finalizei #[a.bold.underlined(href='https://cursos.alura.com.br/user/romulobastos', rel='noreferrer' target='_blank') alguns cursos]
			
			.grid-item.jobs.with-col-divisor.with-row-divisor
				include includes/my-jobs

			.grid-item.art.with-row-divisor
				.image(style='background-image:url(/img/profile-picture.webp)')