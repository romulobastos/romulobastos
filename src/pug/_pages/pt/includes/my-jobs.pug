.my-jobs
	h3.title Projetos em destaque
	p Uma seleção de projetos com foco em interface, performance e tecnologias modernas de front-end.

	.row
		h4.category
			i.fa.fa-asterisk
			|  Design
		nav
			ul
				li
					a(href='https://dribbble.com/romulobastos' rel='noreferrer' target='_blank')
						span.list-icon: i.fab.fa-dribbble
						div
							strong Dribbble
								span.badge-icon: i.fa.fa-star
							span.gray.small Branding &bull; #[abbr(title='User Interface') UI] Design &bull; Ilustração
				//- li
					a(href='https://www.behance.net/_romulobastos' rel='noreferrer' target='_blank')
						span.list-icon: i.fab.fa-behance
						strong Behance
						span.gray  &bull; #[abbr(title='Interface de Usuário') UI] &amp; marcas
	.row
		h4.category
			i.fa.fa-code
			|  Web
		nav
			ul
				li
					a(href='https://www.pdkart.com.br/' rel='noreferrer' target='_blank')
						span.list-icon: i.fa.fa-flag-checkered
						div
							strong PDKART Racing
								span.badge-icon: i.fa.fa-star
							span Equipe de Kart Profissional
							span.gray.small UI/UX &bull; Wordpress CMS &bull; Tailwind
				li
					a(href='https://www.rotinacinefila.com.br/' rel='noreferrer' target='_blank')
						span.list-icon: i.fa.fa-film
						div
							strong Rotina Cinéfila
							span Blog de Entretenimento
							span.gray.small UI/UX &bull; React.js &bull; Next.js &bull; Prismic CMS
				li
					a(href='https://villafacil.bitbucket.io/' rel='noreferrer' target='_blank')
						span.list-icon: i.fa.fa-building
						div
							strong Villa Fácil
							span Gestão de Condomínios
							span.gray.small UI/UX &bull; PHP &bull; HTML &bull; Pug.js
				li
					a(href='https://janacouto.netlify.app/' rel='noreferrer' target='_blank')
						span.list-icon: i.fa.fa-scissors
						div
							strong Jana Couto
							span Cabeleireira &amp; Maquiadora
							span.gray.small UI/UX &bull; HTML &bull; Pug.js

